public class Lab12Prob03 {

public static String reverseString(String str) {
return reverseString(str, str.length() - 1);
    }

// Helper method to perform the recursion using an index parameter
public static String reverseString(String str, int index) {
	if (index == 0) {
		return String.valueOf(str.charAt(0));
} else {
	return str.charAt(index) + reverseString(str, index - 1);
    }
}

public static void main(String[] args) {
		System.out.println(reverseString("recursion")); // Expected: noisrucer
		System.out.println(reverseString("Lab12")); // Expected: 21baL
        }
    }

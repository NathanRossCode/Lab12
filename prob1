public class Lab12Prob01 {

	// recursion

	public static int recursiveAbstract(int fNum) {

		if (fNum == 0) {
			return 1;
		} else if (fNum == 1) {
			return 3;
		} else if (fNum == 2) {
			return 4;
		} else {
			return recursiveAbstract(fNum - 3) * (recursiveAbstract(fNum - 2) - recursiveAbstract(fNum - 1));
		}

	}

}
